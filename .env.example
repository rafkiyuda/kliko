# DATABASE_URL menggunakan connection pooler (port 6543) dengan pgbouncer=true untuk Vercel/Runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0"

# DIRECT_URL menggunakan koneksi langsung (port 5432) untuk Prisma CLI / Migration / Push
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Gemini AI API Key
NEXT_PUBLIC_GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Midtrans Payment Gateway Sandbox
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="false"

# Session Secret (Random string minimal 32 karakter untuk enkripsi JWT session)
SESSION_SECRET="your-super-secret-jwt-key-2026-secure-auth"

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
