generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum KlikoRole {
  CUSTOMER
  TUKANG
  SELLER
  ADMIN
}

enum KlikoTukangBadge {
  BRONZE
  SILVER
  GOLD_MASTER
}

enum KlikoMaterialCondition {
  SURPLUS_BRAND_NEW
  RECLAIMED_LIKE_NEW
  UPCYCLED_RAW
}

enum KlikoOrderType {
  SERVICE_ONLY
  MATERIAL_ONLY
  BUNDLING_PACKAGE
}

enum KlikoOrderStatus {
  PENDING_CONFIRMATION
  MATCHING_TUKANG
  SCHEDULED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum KlikoPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  phone        String?
  role         KlikoRole       @default(CUSTOMER)
  avatarUrl    String?         @map("avatar_url")
  address      String?
  city         String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tukangProfile TukangProfile?
  orders       Order[]         @relation("CustomerOrders")
  materials    MaterialProduct[] @relation("SellerMaterials")
  reviews      Review[]        @relation("UserReviews")
  aiScans      AiDamageScan[]  @relation("UserAiScans")

  @@map("kliko_users")
}

model TukangProfile {
  id                      String           @id @default(uuid())
  userId                  String           @unique @map("user_id")
  badge                   KlikoTukangBadge @default(BRONZE)
  specialties             String[]
  yearsExperience         Int              @default(3) @map("years_experience")
  completedJobs           Int              @default(0) @map("completed_jobs")
  rating                  Float            @default(5.0)
  reviewCount             Int              @default(0) @map("review_count")
  dailyRate               Float?           @map("daily_rate")
  isVerified              Boolean          @default(false) @map("is_verified")
  idCardVerified          Boolean          @default(false) @map("id_card_verified")
  skillCertificateVerified Boolean         @default(false) @map("skill_certificate_verified")
  bio                     String?
  location                String           @default("Jakarta Selatan, Jabodetabek")
  isActive                Boolean          @default(true) @map("is_active")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedOrders          Order[]          @relation("TukangOrders")
  reviews                 Review[]         @relation("TukangReviews")

  @@map("kliko_tukang_profiles")
}

model Service {
  id             String      @id @default(uuid())
  title          String
  category       String      // e.g. "Keramik & Lantai", "Cat & Dinding", "Plumbing", "Kelistrikan", "Atap & Plafon", "Garasi & Kanopi"
  description    String
  priceType      String      @map("price_type") // "per_m2", "per_titik", "per_hari", "per_proyek"
  basePrice      Float       @map("base_price")
  unit           String      // "m²", "titik", "hari", "unit"
  estimatedHours Int         @default(4) @map("estimated_hours")
  icon           String?
  imageUrl       String?     @map("image_url")
  includedScope  String[]    @map("included_scope")
  warrantyDays   Int         @default(14) @map("warranty_days")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  orderItems     OrderItem[]

  @@map("kliko_services")
}

model MaterialProduct {
  id               String                 @id @default(uuid())
  sellerId         String                 @map("seller_id")
  title            String
  category         String                 // "Keramik & Granit", "Cat & Finishing", "Baja Ringan & Besi", "Puing & Agregat Daur Ulang", "Pipa & Sanitari", "Kayu Kusen"
  description      String
  condition        KlikoMaterialCondition @default(SURPLUS_BRAND_NEW)
  originalPrice    Float                  @map("original_price")
  discountedPrice  Float                  @map("discounted_price")
  stock            Int                    @default(1)
  unit             String                 // "dus", "pail", "batang", "truk m³", "sak", "pcs"
  location         String                 @default("Jakarta Selatan")
  isGreenMaterial  Boolean                @default(false) @map("is_green_material")
  carbonSavedKg    Float?                 @map("carbon_saved_kg")
  imageUrl         String                 @map("image_url")
  logisticsReady   Boolean                @default(true) @map("logistics_ready")
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  seller           User                   @relation("SellerMaterials", fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]

  @@map("kliko_material_products")
}

model BundlingPackage {
  id                String      @id @default(uuid())
  title             String
  description       String
  category          String      // "Renovasi Garasi", "Renovasi Kamar Mandi", "Pengecatan Rumah", "Pasang Keramik Ruangan"
  totalNormalPrice  Float       @map("total_normal_price")
  bundlingPrice     Float       @map("bundling_price")
  savingsPercent    Int         @default(25) @map("savings_percent")
  estimatedDays     Int         @default(2) @map("estimated_days")
  imageUrl          String      @map("image_url")
  badgeText         String?     @map("badge_text") // e.g. "Hemat 30% + Bebas Nego"
  scopeList         String[]    @map("scope_list")
  materialsIncluded String[]    @map("materials_included")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  orderItems        OrderItem[]

  @@map("kliko_bundling_packages")
}

model Order {
  id            String           @id @default(uuid())
  orderNumber   String           @unique @map("order_number")
  customerId    String           @map("customer_id")
  tukangId      String?          @map("tukang_id")
  orderType     KlikoOrderType   @map("order_type")
  status        KlikoOrderStatus @default(PENDING_CONFIRMATION)
  totalAmount   Float            @map("total_amount")
  scheduledDate DateTime         @map("scheduled_date")
  address       String
  city          String           @default("Jakarta")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  customer      User             @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  tukang        TukangProfile?   @relation("TukangOrders", fields: [tukangId], references: [id])
  items         OrderItem[]
  workLogs      WorkLog[]
  transaction   Transaction?

  @@map("kliko_orders")
}

model OrderItem {
  id         String           @id @default(uuid())
  orderId    String           @map("order_id")
  serviceId  String?          @map("service_id")
  materialId String?          @map("material_id")
  bundleId   String?          @map("bundle_id")
  name       String
  price      Float
  quantity   Int              @default(1)
  unit       String?

  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service    Service?         @relation(fields: [serviceId], references: [id])
  material   MaterialProduct? @relation(fields: [materialId], references: [id])
  bundle     BundlingPackage? @relation(fields: [bundleId], references: [id])

  @@map("kliko_order_items")
}

model WorkLog {
  id               String    @id @default(uuid())
  orderId          String    @map("order_id")
  beforeImageUrl   String?   @map("before_image_url")
  afterImageUrl    String?   @map("after_image_url")
  beforeNotes      String?   @map("before_notes")
  afterNotes       String?   @map("after_notes")
  progressPercent  Int       @default(0) @map("progress_percent")
  scopeCompleted   String[]  @map("scope_completed")
  warrantyExpiry   DateTime? @map("warranty_expiry")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByAdmin  Boolean   @default(false) @map("verified_by_admin")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kliko_work_logs")
}

model Transaction {
  id                  String             @id @default(uuid())
  orderId             String             @unique @map("order_id")
  amount              Float
  serviceCommission   Float              @default(0) @map("service_commission")
  materialPlatformFee Float              @default(0) @map("material_platform_fee")
  tukangPayout        Float              @default(0) @map("tukang_payout")
  sellerPayout        Float              @default(0) @map("seller_payout")
  paymentMethod       String             @default("QRIS") @map("payment_method")
  paymentStatus       KlikoPaymentStatus @default(PENDING) @map("payment_status")
  paidAt              DateTime?          @map("paid_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kliko_transactions")
}

model Review {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  tukangId  String?        @map("tukang_id")
  rating    Int            @default(5)
  comment   String
  createdAt DateTime       @default(now()) @map("created_at")

  user      User           @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  tukang    TukangProfile? @relation("TukangReviews", fields: [tukangId], references: [id])

  @@map("kliko_reviews")
}

model AiDamageScan {
  id                   String   @id @default(uuid())
  userId               String?  @map("user_id")
  imageUrl             String?  @map("image_url")
  itemName             String   @map("item_name") // e.g. "AC Split 1 PK", "Wastafel Keramik", "Dinding Kamar Mandi"
  damageTitle          String   @map("damage_title") // e.g. "Pipa Pembuangan Wastafel Bocor & Siphon Rusak"
  damageDescription    String   @map("damage_description")
  severity             String   // "Ringan", "Sedang", "Parah"
  estimatedMinPrice    Float    @map("estimated_min_price")
  estimatedMaxPrice    Float    @map("estimated_max_price")
  recommendedService   String?  @map("recommended_service")
  recommendedMaterials String[] @map("recommended_materials")
  urgencyAdvice        String?  @map("urgency_advice")
  suggestedSteps       String[] @map("suggested_steps")
  createdAt            DateTime @default(now()) @map("created_at")

  user                 User?    @relation("UserAiScans", fields: [userId], references: [id], onDelete: SetNull)

  @@map("kliko_ai_scans")
}
